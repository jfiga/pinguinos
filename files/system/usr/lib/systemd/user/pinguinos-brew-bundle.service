[Unit]
Description=Install Homebrew packages from the pinguinos Brewfile
# Brew is owned by UID 1000 and set up at boot by brew-setup.service
ConditionUser=1000
ConditionPathExists=/home/linuxbrew/.linuxbrew/bin/brew

[Service]
Type=oneshot
Environment=HOMEBREW_NO_ANALYTICS=1
ExecStart=/usr/bin/bash -c '/home/linuxbrew/.linuxbrew/bin/brew bundle check --file=/usr/share/pinguinos/Brewfile || /home/linuxbrew/.linuxbrew/bin/brew bundle install --file=/usr/share/pinguinos/Brewfile'
# Retry if the network isn't up yet
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
